# LanOps Tournament Manager — environment configuration
# Copy this to .env and fill in your values

# Server
PORT=8080
HOST=localhost

# PostgreSQL
# When using docker compose, POSTGRES_PASSWORD is read by the postgres service container.
# DATABASE_URL must use the same credentials.
POSTGRES_PASSWORD=lanops
DATABASE_URL=postgres://lanops:lanops@localhost:5432/lanops_tournament?sslmode=disable

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URL=http://localhost:8080/auth/callback
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_ADMIN_ROLE_ID=your_admin_role_id
DISCORD_GUILD_ID=your_guild_id

# Session security (generate with: openssl rand -hex 32)
SESSION_SECRET=change_this_to_a_random_64_char_hex_string

# CSRF protection (must be exactly 32 bytes / 64 hex chars)
CSRF_AUTH_KEY=change_this_to_a_random_64_char_hex_string

# Security — set to true when running behind TLS in production
SECURE_COOKIES=false

# Tournament limits
MAX_PARTICIPANTS=64
